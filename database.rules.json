{
  "rules": {
    "rooms": {
      "$code": {
        ".read": true,
        ".write": "auth != null && (!data.exists() || data.child('hostUid').val() === auth.uid)",
        ".validate": "newData.child('hostUid').val() === auth.uid"
      }
    },
    "lyrics": {
      "$trackId": {
        ".read": true,
        ".write": "auth != null && !data.exists()",
        ".validate": "newData.hasChildren(['lines'])",
        "lines": {
          "$i": {
            ".validate": "$i.matches(/^[0-9]{1,3}$/) && newData.child('timeMs').isNumber() && newData.child('text').isString() && newData.child('text').val().length < 500 && newData.child('roman').isString() && newData.child('roman').val().length < 1000",
            "$field": { ".validate": "$field === 'timeMs' || $field === 'text' || $field === 'roman'" }
          }
        },
        "$other": { ".validate": false }
      }
    }
  }
}
